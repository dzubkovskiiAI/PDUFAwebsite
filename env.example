# Copy this file to ".env" (same folder) and fill it in. Never share or upload .env.
GEMINI_API_KEY=paste-your-key-here
# Your own name and email. The SEC requires real contact details.
SEC_USER_AGENT=Your Name your.email@example.com

# Optional
# GEMINI_MODEL is chosen with PDUFA_MODEL. Copy a current Flash model name from aistudio.google.com.
# PDUFA_MODEL=gemini-2.5-flash
# Seconds to wait between Gemini calls (free tier has rate limits)
# PDUFA_CALL_DELAY=4
# Also copy events.json, events.csv and pdufa.ics to this folder after each run
# PDUFA_EXPORT_DIR=C:\Users\you\My Drive\pdufa
